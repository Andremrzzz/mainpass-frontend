# Copie para .env. Sem VITE_API_URL o sistema usa o armazenamento local do navegador.
VITE_API_URL=http://localhost:8080
# Id do Ambiente (tabela ambiente) controlado pela portaria; enviado em POST /api/acessos/validar
VITE_AMBIENTE_ID=1
# Valor do enum Perfil que identifica moradores na API
VITE_PERFIL_MORADOR=USUARIO
